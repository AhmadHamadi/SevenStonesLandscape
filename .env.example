# Server-only configuration for /api/quote. Never prefix these with VITE_ or NEXT_PUBLIC_.
RESEND_API_KEY=
GHL_INBOUND_WEBHOOK_URL=

# Optional sender override; use only a verified sending domain.
EMAIL_FROM=

# Optional SMTP fallback (Resend is the configured production transport).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ENVELOPE_FROM=
